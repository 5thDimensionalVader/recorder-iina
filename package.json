{
  "name": "recorder-iina",
  "version": "1.0.0",
  "private": true,
  "description": "Clip moments from videos in IINA.",
  "license": "ISC",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm clean && pnpm --filter @recorder/contracts typecheck && pnpm --filter @recorder/ui build && pnpm --filter @recorder/plugin build && pnpm package:validate",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check && pnpm build",
    "clean": "rimraf dist packages/*/dist coverage .artifacts",
    "dev": "pnpm --filter @recorder/ui dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "iina:link": "pnpm build && iina-plugin link .",
    "iina:unlink": "iina-plugin unlink .",
    "lint": "eslint .",
    "package:validate": "node scripts/validate-package.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
